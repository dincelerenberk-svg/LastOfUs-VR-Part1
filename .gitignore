[Llvm]
# This .gitignore file should be added to your Unity project root.
# It is generated by Unity and should not be committed as-is if you are editing a Unity project.
# Feel free to modify as needed.

[Ll]
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
/[Mm]emoryCaptures/

# Asset meta data should never be edited manually.
**/*.pidb
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db

# Unity3D generated meta files
**/*.meta

# Visual Studio / Rider generated files
.vscode/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.shows
*.sln
*.csproj
*.unityproj
*.user
*.userprefs
*.pidb
*.booproj
*.sln
*.suo
*.tmp
*.log
*.bak

# Crashlytics generated file
crashlytics-build.properties

# Project generated artifacts
*.apk
*.aab
*.unitypackage

# OS-specific files
.DS_Store
Thumbs.db

# Rider
.idea/
